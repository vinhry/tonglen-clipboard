PORT=7582
DISCOVERY_PORT=7583
NODE_ENV=development

# Set to 1 only when running behind a reverse proxy (nginx, Caddy, ...).
# Client IPs then come from X-Forwarded-For; when off, forwarded headers are ignored.
TRUST_PROXY=0

# Extra origins allowed to open WebSocket connections (comma-separated).
# Only needed if the proxy rewrites Host without setting X-Forwarded-Host.
# ALLOWED_ORIGINS=https://clip.example.com
